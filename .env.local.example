# Stripe API Keys
# テスト用キーは https://dashboard.stripe.com/test/apikeys で取得できます
STRIPE_SECRET_KEY=<your-stripe-secret-key>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<your-stripe-publishable-key>

# Webhook シークレット
# ローカル: stripe listen --forward-to localhost:3000/api/webhook で取得
# 本番: https://dashboard.stripe.com/webhooks で取得
STRIPE_WEBHOOK_SECRET=<your-stripe-webhook-secret>

# アプリのURL（本番環境では実際のURLに変更してください）
NEXT_PUBLIC_BASE_URL=http://localhost:3000
